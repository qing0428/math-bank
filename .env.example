# 数据持久化目录（宿主机路径，映射到容器内 /data）
# 默认 ./data（项目相对路径），可改为绝对路径
DATA_DIR=./data

# ── 飞书机器人配置（可选）──
# 在飞书开放平台创建应用后获取
# FEISHU_APP_ID=your_app_id
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_VERIFY_TOKEN=your_verify_token

# ── 飞书机器人视觉识别 API（可选，用于飞书图片识别）──
# VISION_API_BASE=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# VISION_API_KEY=your_api_key
# VISION_MODEL=qwen-vl-max
